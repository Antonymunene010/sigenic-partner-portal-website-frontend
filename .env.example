# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/partner_portal
DATABASE_SSL=false
PORT=8787

# --- Auth ---
# HMAC secret used to sign session tokens. MUST be set to a long random value in production.
AUTH_SECRET=change-me-in-production
# Token lifetime in seconds (default 12h).
AUTH_TTL_SECONDS=43200
# Password assigned to seeded demo accounts on first boot.
SEED_DEFAULT_PASSWORD=demo

# --- Email (notifications) ---
# With SMTP_HOST set, emails are sent for real. Locally, docker compose runs a
# mailpit sink (host "mailpit", web UI on :8025). Leave blank to use the outbox.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Sigenic Partner Portal <no-reply@sigenic.com>

# --- Zendesk (optional two-way ticket sync) ---
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_SYNC_INTERVAL_MS=60000

# --- CORS (only needed when frontend is served from a different origin) ---
CORS_ORIGIN=*
