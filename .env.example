# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/partner_portal
DATABASE_SSL=false
PORT=8787

# --- Auth ---
# HMAC secret used to sign session tokens. MUST be set to a long random value in production.
AUTH_SECRET=change-me-in-production
# Token lifetime in seconds (default 12h).
AUTH_TTL_SECONDS=43200
# Password assigned to seeded demo accounts on first boot.
SEED_DEFAULT_PASSWORD=demo

# --- Email (notifications) ---
# Priority: SMTP_HOST set → real SMTP send. Otherwise → outbox-only (every send
# is recorded to the DB and visible at GET /api/emails, but not delivered).
#
# Locally docker compose runs a mailpit sink (host "mailpit", web UI on :8025)
# so all emails are captured for inspection. Leave SMTP_HOST blank to keep
# outbox-only mode.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Default From: identity. Used for invite / password / signup / announcement /
# ticket mail — i.e. everything except calculator (ROI) leads.
EMAIL_FROM=Sigenic Partner Portal <noreply@sigenic.com>
# Calculator (ROI) lead notifications & receipts use this From: identity.
# Leave blank to fall back to EMAIL_FROM. Set to a separate mailbox so the
# sales team gets replies — client request 2026-06-27.
EMAIL_FROM_SALES=Sigenic Sales <sigenic_sales@sigenic.com>
# Optional dedicated SMTP credentials for sales mail. host/port/secure are
# always inherited from SMTP_*. Required on standard smtp.gmail.com, which
# rewrites From: to the authenticated user — without these the sales From:
# header silently snaps back to SMTP_USER. Not needed on smtp-relay.gmail.com
# / SES / Mailgun and other relays that allow arbitrary senders.
SMTP_USER_SALES=
SMTP_PASS_SALES=
# Base URL emailed in invite/reset links. Set to your production URL.
APP_BASE_URL=

# --- Zendesk (optional two-way ticket sync) ---
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_SYNC_INTERVAL_MS=60000
# Per-request timeout (ms) for outbound Zendesk/Notion calls. A hung request
# aborts after this instead of stalling the sync loop; aborted / 5xx / 429
# responses are retried with backoff.
ZENDESK_TIMEOUT_MS=10000

# --- Notion (optional knowledge-base content source) ---
# Create an internal integration at notion.so/my-integrations, share the KB
# database with it, then paste the secret + database id here. Leave blank to keep
# the KB portal-authored only (source_type='portal'). Sync is one-way (Notion →
# portal cache); the portal still governs featured/category/audience per PRD §8.
NOTION_TOKEN=
NOTION_KB_DATABASE_ID=
NOTION_SYNC_INTERVAL_MS=300000
NOTION_VERSION=2022-06-28

# --- CORS (only needed when frontend is served from a different origin) ---
CORS_ORIGIN=*
