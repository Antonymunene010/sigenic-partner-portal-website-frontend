# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/partner_portal
DATABASE_SSL=false
PORT=8787

# --- Auth ---
# HMAC secret used to sign session tokens. MUST be set to a long random value in production.
AUTH_SECRET=change-me-in-production
# Token lifetime in seconds (default 12h).
AUTH_TTL_SECONDS=43200
# Password assigned to seeded demo accounts on first boot.
SEED_DEFAULT_PASSWORD=demo

# --- Email (notifications) ---
# Priority: MAILERSEND_API_TOKEN → SMTP_HOST → outbox-only.
#
# On Render / Vercel / Fly etc., outbound SMTP ports (25/465/587) are blocked,
# so set MAILERSEND_API_TOKEN to use MailerSend's HTTPS API (port 443) instead.
# Get a token at https://app.mailersend.com/api-tokens and verify your sending
# domain (TXT records only — no MX needed, works with Wix-managed DNS).
MAILERSEND_API_TOKEN=
# SMTP fallback — used when MAILERSEND_API_TOKEN is empty. Locally docker
# compose runs a mailpit sink (host "mailpit", web UI on :8025). Leave
# SMTP_HOST blank for outbox-only mode.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Sigenic Partner Portal <no-reply@sigenic.com>
# Base URL emailed in invite/reset links. Set to your production URL on Render.
APP_BASE_URL=

# --- Zendesk (optional two-way ticket sync) ---
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_SYNC_INTERVAL_MS=60000
# Per-request timeout (ms) for outbound Zendesk/Notion calls. A hung request
# aborts after this instead of stalling the sync loop; aborted / 5xx / 429
# responses are retried with backoff.
ZENDESK_TIMEOUT_MS=10000

# --- Notion (optional knowledge-base content source) ---
# Create an internal integration at notion.so/my-integrations, share the KB
# database with it, then paste the secret + database id here. Leave blank to keep
# the KB portal-authored only (source_type='portal'). Sync is one-way (Notion →
# portal cache); the portal still governs featured/category/audience per PRD §8.
NOTION_TOKEN=
NOTION_KB_DATABASE_ID=
NOTION_SYNC_INTERVAL_MS=300000
NOTION_VERSION=2022-06-28

# --- CORS (only needed when frontend is served from a different origin) ---
CORS_ORIGIN=*
