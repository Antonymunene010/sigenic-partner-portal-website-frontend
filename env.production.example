################################################################################
# Sigenic Partner Portal — PRODUCTION
# Host:  43.156.19.185  (KCCDigital-Apps-PROD-SG, Singapore)
# Path:  /www/wwwroot/sigenic-prod
# URL:   https://partner.sigenic.com
# PM2:   sigenic-prod  (PORT 3002 — 3000 is used by another app on this host)
#
# Install:
#   cp .env.production.example /www/wwwroot/sigenic-prod/.env
#   # fill secrets, then:
#   pm2 delete sigenic-prod
#   env -u DATABASE_URL -u DATABASE_SSL \
#     pm2 start npm --name sigenic-prod --cwd /www/wwwroot/sigenic-prod -- start
#   pm2 save
#
# Database: local PostgreSQL on the VM (NOT shared with UAT, NOT the old Neon).
# Old Neon URL must be kept in a secure backup only — do not put it back here
# unless intentionally restoring historical data.
################################################################################

# --- Runtime ---
PORT=3002
APP_BASE_URL=https://partner.sigenic.com
# CORS_ORIGIN=https://partner.sigenic.com

# --- Database (local Postgres on this VM) ---
DATABASE_URL=postgresql://sigenic_prod:REPLACE_DB_PASSWORD@127.0.0.1:5432/sigenic_prod
DATABASE_SSL=false

# --- Auth ---
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Prefer a strong password for any seeded accounts in production.
SEED_DEFAULT_PASSWORD=REPLACE_DEMO_SEED_PASSWORD

# --- Email (Gmail / Google Workspace) ---
# Authenticate as the PRIMARY mailbox. noreply@ is an alias (cannot SMTP-login).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@sigenic.com
SMTP_PASS=REPLACE_WITH_GOOGLE_APP_PASSWORD
EMAIL_FROM=Sigenic <noreply@sigenic.com>

# --- Zendesk (optional) ---
ZENDESK_SUBDOMAIN=REPLACE_OR_LEAVE_BLANK
ZENDESK_EMAIL=REPLACE_OR_LEAVE_BLANK
ZENDESK_API_TOKEN=REPLACE_OR_LEAVE_BLANK
ZENDESK_SYNC_INTERVAL_MS=60000

# --- Notion KB (optional) ---
NOTION_TOKEN=REPLACE_OR_LEAVE_BLANK
NOTION_KB_DATABASE_ID=REPLACE_OR_LEAVE_BLANK
NOTION_SYNC_INTERVAL_MS=300000


