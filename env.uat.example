################################################################################
# Sigenic Partner Portal — UAT
# Host:  43.160.219.229
# Path:  /www/wwwroot/uat-partner
# URL:   https://uat-partner.sigenic.com
# PM2:   uat-partner  (PORT 3003)
#
# Install:
#   cp .env.uat.example /www/wwwroot/uat-partner/.env
#   # fill secrets, then:
#   pm2 restart uat-partner
#
# IMPORTANT: loadEnvFile does NOT override vars already set in the process
# environment. After changing DATABASE_URL, delete/restart PM2 with a clean env.
################################################################################

# --- Runtime ---
PORT=3003
APP_BASE_URL=https://uat-partner.sigenic.com
# CORS_ORIGIN=https://uat-partner.sigenic.com

# --- Database (Neon UAT project — separate from production) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_SSL=true

# --- Auth ---
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SEED_DEFAULT_PASSWORD=demo

# --- Email (Gmail / Google Workspace) ---
# Authenticate as the PRIMARY mailbox. noreply@ is an alias (cannot SMTP-login).
# Visible From uses EMAIL_FROM; Google may rewrite to SMTP_USER unless
# "Send mail as" is enabled for noreply@ on the sales account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@sigenic.com
SMTP_PASS=REPLACE_WITH_GOOGLE_APP_PASSWORD
EMAIL_FROM=Sigenic <noreply@sigenic.com>

# --- Zendesk (optional; leave blank to disable) ---
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_SYNC_INTERVAL_MS=60000

# --- Notion KB (optional; leave blank to disable) ---
NOTION_TOKEN=
NOTION_KB_DATABASE_ID=
NOTION_SYNC_INTERVAL_MS=300000


